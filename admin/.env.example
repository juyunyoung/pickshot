# 관리자 웹 환경변수 템플릿
# 이 파일을 복사해서 admin/.env.local 을 만들고 값을 채운다 (.env.local은 커밋되지 않음)
#   cp admin/.env.example admin/.env.local

# ── 공개 값: 브라우저 코드에서 읽음. NEXT_PUBLIC_ 접두사 필수 ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 비밀 값: 서버 코드에서만 읽음. NEXT_PUBLIC_ 붙이지 말 것 ──
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
