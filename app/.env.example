# 앱 환경변수 템플릿
# 이 파일을 복사해서 app/.env.local 을 만들고 값을 채운다 (.env.local은 커밋되지 않음)
#   cp app/.env.example app/.env.local

# ── 공개 값: 앱(브라우저) 코드에서 읽음. VITE_ 접두사 필수 ──
# Supabase 대시보드 > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# anon key 또는 publishable key (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=

# ── 비밀 값: 서버 함수(createServerFn) 안에서만 읽음. VITE_ 붙이지 말 것 ──
# service role key 또는 secret key (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=
# Google AI Studio > Get API key
GEMINI_API_KEY=

# ── SNS 게시용 메타 앱 (서버 전용) — developers.facebook.com > 내 앱 ──
# 로그인용 구글·애플·카카오·페이스북 키는 여기가 아니라 Supabase 대시보드 > Authentication > Providers 에 넣는다
# 페이스북 페이지 게시: 앱 설정 > 기본 설정
META_APP_ID=
META_APP_SECRET=
# 인스타그램 게시: 인스타그램 제품 > API 설정의 Instagram 앱 ID·시크릿
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# 쓰레드 게시: 쓰레드 제품 > 설정의 Threads 앱 ID·시크릿
THREADS_APP_ID=
THREADS_APP_SECRET=
